# ---------------------------------------------------------------------------
# NewsUpdate — example configuration. Copy to `.env` and fill in.
# Never commit the real .env.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=3000
# Public base URL, used to build verification and unsubscribe links in emails.
BASE_URL=https://news.example.com
# Set to true only when serving over plain HTTP behind no TLS (local dev).
INSECURE_COOKIES=false
# Trust X-Forwarded-* headers (set to true when behind nginx/Caddy/Cloudflare).
TRUST_PROXY=true

# --- Storage ---------------------------------------------------------------
DATABASE_PATH=./data/newsupdate.sqlite

# --- Secrets ---------------------------------------------------------------
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
TOKEN_SECRET=

# --- Admin console ---------------------------------------------------------
# The admin console is mounted at this path. Keep it long and unguessable.
# Generate with:  node -e "console.log('/console-'+require('crypto').randomBytes(12).toString('hex'))"
ADMIN_PATH=/console-change-me-to-a-random-string
# Admin login is bound to this single address; no other email can sign in.
ADMIN_EMAIL=sunnytan30@gmail.com
# Set with:  npm run admin:password
# (stores a scrypt hash in the database; never store the plaintext here)

# --- Outbound email --------------------------------------------------------
# smtp | resend | console   ("console" just logs the email; for local dev only)
MAIL_PROVIDER=smtp
MAIL_FROM="News Update <digest@news.example.com>"
MAIL_REPLY_TO=
# SMTP (any transactional provider: Postmark, SES, Brevo, Mailgun...)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Resend
RESEND_API_KEY=

# --- Summarisation ---------------------------------------------------------
# anthropic | extractive   (extractive needs no API key but reads far worse)
SUMMARISER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Daily digest ----------------------------------------------------------
# Process timezone: used for log timestamps and the housekeeping schedule.
TZ=Asia/Singapore

# Timezone assigned to a subscriber who does not pick one on the sign-up form.
# Must be an IANA name. Defaults to TZ when left blank.
DEFAULT_TIMEZONE=Asia/Singapore

# Local hour (0-23) at which each subscriber receives their digest, in THEIR
# OWN timezone. 7 means 07:00 in Singapore for a Singapore subscriber and
# 07:00 in London for a London subscriber. The admin console can change this
# at runtime; the value here only seeds it on first boot.
DEFAULT_SEND_HOUR=7

# How often to check whether anyone has reached their send hour. Every 15
# minutes covers offsets that are not whole hours (India +05:30, Nepal +05:45).
# A sweep with nobody due runs one query and fetches nothing.
DIGEST_SWEEP_CRON=*/15 * * * *

# Run the scheduler in this process. Set false if you drive it via an external
# cron, which should then call `node dist/cli/run-digest.js` on the same cadence.
ENABLE_SCHEDULER=true
# Default number of source URLs a new subscriber may register (admin can change).
DEFAULT_SOURCE_LIMIT=5
# Maximum stories included in one digest email.
MAX_STORIES_PER_EMAIL=8

# --- Fetching behaviour ----------------------------------------------------
FETCH_USER_AGENT=NewsUpdateBot/1.0 (+https://news.example.com/about)
FETCH_TIMEOUT_MS=15000
FETCH_MAX_BYTES=3000000
FETCH_CONCURRENCY=4
# Minimum delay between two requests to the same host, in milliseconds.
FETCH_HOST_DELAY_MS=1500
# Respect robots.txt. Leave true.
RESPECT_ROBOTS=true
# Allow fetching private/loopback addresses. Leave false — true enables SSRF.
ALLOW_PRIVATE_NETWORK=false
